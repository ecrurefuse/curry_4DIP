# Coulomb Field Test

import numpy as np
import time

def log_coulomb_result(field, energy, iterations, t, start_time):
    print(f"\n--- Coulomb Field Test ---")
    print(f"Final Field: {field:.14e} N/C")
    print(f"Final Energy: {energy:.14e}")
    print(f"Iterations: {iterations}")
    print(f"Simulated Time: {t:.6f} s")
    print(f"Runtime: {time.time() - start_time:.6f} s")
    print("------------------------------")

# Constants for Coulomb field
k = 8.9875517923e9  # Coulomb's constant (N·m²/C²)
q = 1e-9  # charge (C)
r = 1.0  # distance (m)

def coulomb_field(k, q, r):
    return k * q / r**2

def coulomb_energy(field, distance):
    return field * distance

# Initialization
field = coulomb_field(k, q, r)
energy = coulomb_energy(field, r)
iterations = 0
t = 0.0
max_iter = 200000
precision_threshold = 1e-14
energy_log = [energy]
start_time = time.time()

# Main loop
while iterations < max_iter:
    prev_energy = energy_log[-1]
    field = coulomb_field(k, q, r)
    energy = coulomb_energy(field, r)
    energy_log.append(energy)
    t += 0.01
    iterations += 1
    if abs(energy - prev_energy) < precision_threshold:
        break

log_coulomb_result(field, energy, iterations, t, start_time)

